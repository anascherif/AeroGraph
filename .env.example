# NVIDIA NIM API (free at build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=glm-5.1

# Groq API (free at console.groq.com)
GROQ_API_KEY=gsk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_STT_MODEL=whisper-large-v3-turbo

# Camera source
# Use "0" for laptop webcam, or "http://192.168.1.100:8080/video" for IP Webcam app
CAMERA_SOURCE=0

# Paths (relative to project root)
DATA_DIR=data
MODELS_DIR=backend/models
CHROMA_PATH=data/chroma

# Safety monitor — notification channels (all optional; absent = dry-run)
# Telegram: create a bot via @BotFather, paste the token here.
# Leave blank to disable Telegram alerts (WhatsApp + Twilio still fire).
TELEGRAM_BOT_TOKEN=
# Optional group chat fallback for the alert voice notes (numeric chat id).
TELEGRAM_CHAT_ID=

# WhatsApp bridge URL (default local Baileys bridge in notifier-whatsapp/).
# Start the bridge with:  cd notifier-whatsapp && npm install && node index.js
# Requires one-time QR scan from your phone.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:7878

# Twilio voice calls (Tier 3 escalation).
# Note: outbound voice calls to Tunisian (+216) numbers are NOT supported.
# Leave any field blank to run Twilio in dry-run mode (logs the call instead).
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
