# NVIDIA NIM API (free at build.nvidia.com)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=glm-5.1

# Groq API (free at console.groq.com)
GROQ_API_KEY=gsk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_STT_MODEL=whisper-large-v3-turbo

# Camera source
# Use "0" for laptop webcam, or "http://192.168.1.100:8080/video" for IP Webcam app
CAMERA_SOURCE=0

# Paths (relative to project root)
DATA_DIR=data
MODELS_DIR=backend/models
CHROMA_PATH=data/chroma
